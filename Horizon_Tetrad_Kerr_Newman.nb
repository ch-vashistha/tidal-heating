     RowBox[{"rKS", "[", "]"}], ",", 
     RowBox[{"\[Theta]KS", "[", "]"}], ",", " ", 
     RowBox[{"\[Psi]", "[", "]"}]}], "}"}], ",", 
   RowBox[{"ChartColor", "\[Rule]", "Green"}]}], "]"}]}], "Input",
