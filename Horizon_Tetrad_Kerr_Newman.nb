          RowBox[{"(", 
           RowBox[{"aComp", "[", "]"}], ")"}], 
          RowBox[{"lVec", "[", "a", "]"}]}]}]}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
