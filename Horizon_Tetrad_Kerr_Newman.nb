Cell[TextData[{
 "\nWe use ",
 StyleBox["SetBasisChange ",
  FontWeight->"Bold"],
 "now. \nThis sets a default change of basis. In the one-argument form it \
only pre-computes algebraic expressions, and not derivatives, Christoffels, \
etc."
}], "Text",
