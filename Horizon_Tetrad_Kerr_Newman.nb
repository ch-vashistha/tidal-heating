            RowBox[{"nVec", "[", "a", "]"}], " ", 
            RowBox[{"mbarVec", "[", "b", "]"}]}], "-", 
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "b"}], "]"}], "[", 
