Cell["\<\

Metric functions for Kerr-Newman spacetime, \[CapitalDelta][r] and \
\[CapitalSigma][r, \[Theta]]\
\>", "Text",
 CellChangeTimes->{{3.9973340535139685`*^9, 3.997334078763514*^9}, 
   3.997334113312686*^9, {3.997405092691093*^9, 3.9974050958275537`*^9}, {
   3.9975398101017003`*^9, 
   3.9975398110646286`*^9}},ExpressionUUID->"6683c3af-ed76-4fcc-8166-\
fc9e36d2f5c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Delta", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"r", "^", "2"}], " ", "-", " ", 
    RowBox[{"2", "*", "mass", "*", "r"}], "+", 
    RowBox[{"ang", "^", "2"}], " ", "+", " ", 
    RowBox[{"Q", "^", "2"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9973225995546613`*^9, 3.997322616852456*^9}, {
  3.9973234564495554`*^9, 3.9973234755395126`*^9}, {3.9973245888828077`*^9, 
  3.9973245890031815`*^9}, {3.99740499290536*^9, 3.9974050137248487`*^9}, {
  3.99753965825218*^9, 3.9975396616221666`*^9}},
 CellLabel->"In[85]:=",ExpressionUUID->"8bca99a6-95c2-4a25-aa32-5cd01b0644da"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Sigma", "[", 
    RowBox[{"r_", ",", "\[Theta]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"r", "^", "2"}], "+", 
    RowBox[{
     RowBox[{"ang", "^", "2"}], 
     RowBox[{
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "^", "2"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9973319694409995`*^9, 3.9973320231410384`*^9}, {
  3.997404999451831*^9, 3.9974050171271505`*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"6dc77fb2-fad8-40fd-af25-1f2ed5640caa"],

Cell["\<\
The transformation from Boyer-Lindquist to Kerr-Schild is as follows: \
\>", "Text",
 CellChangeTimes->{{3.997537890983696*^9, 3.9975378990040536`*^9}, {
  3.9975382051036396`*^9, 
  3.9975382132284265`*^9}},ExpressionUUID->"7c69fcae-dcf8-44ed-896d-\
4ee889903483"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MaTeX", "[", 
  "\"\<\\\\begin{aligned}\n v &= \
t+r^{*}(r_{BL})=t+\\\\int\\\\frac{r_{BL}^2+a^2}{\\\\Delta}\\\\,dr_{BL} \
\\qquad r_{KS} &= r_{BL} \\qquad \\\\theta_{KS} &= \\\\theta_{BL} \\\\\\\\\n \
\\\\psi &= \\\\phi+\\\\bar{r}(r_{BL})=\\\\phi+\\\\int\\\\frac{a}{\\\\Delta}\\\
\\,dr_{BL}\n \\\\end{aligned}\>\"", "]"}]], "Input",
 CellOpen->False,
 CellChangeTimes->{{3.9975118490771666`*^9, 3.9975118490771666`*^9}, {
  3.99753794356364*^9, 3.997537985603711*^9}, {3.9975380293640747`*^9, 
