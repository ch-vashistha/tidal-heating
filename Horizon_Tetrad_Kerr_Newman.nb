Cell[BoxData[
 RowBox[{
  RowBox[{"spinCoeffRules", "=", 
   RowBox[{"Join", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Kappa]NP", "[", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "b"}], "]"}], "[", 
          RowBox[{"lVec", "[", 
           RowBox[{"-", "a"}], "]"}], "]"}], " ", 
         RowBox[{"mVec", "[", "a", "]"}], " ", 
         RowBox[{"lVec", "[", "b", "]"}]}]}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Pi]NP", "[", "]"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"CD", "[", 
            RowBox[{"-", "b"}], "]"}], "[", 
           RowBox[{"nVec", "[", 
            RowBox[{"-", "a"}], "]"}], "]"}]}], " ", 
         RowBox[{"mbarVec", "[", "a", "]"}], " ", 
         RowBox[{"lVec", "[", "b", "]"}]}]}], "}"}], "]"}], ",", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Epsilon]NP", "[", "]"}], ",", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "b"}], "]"}], "[", 
             RowBox[{"lVec", "[", 
              RowBox[{"-", "a"}], "]"}], "]"}], " ", 
            RowBox[{"nVec", "[", "a", "]"}], " ", 
            RowBox[{"lVec", "[", "b", "]"}]}], "-", 
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "b"}], "]"}], "[", 
             RowBox[{"mVec", "[", 
              RowBox[{"-", "a"}], "]"}], "]"}], " ", 
            RowBox[{"mbarVec", "[", "a", "]"}], " ", 
            RowBox[{"lVec", "[", "b", "]"}]}]}], ")"}]}]}], "}"}], "]"}], ",", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Rho]NP", "[", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "b"}], "]"}], "[", 
