Cell[TextData[{
 "The class-III rotation has a scaling effect on the Weyl scalars except ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "2"], " "}], TraditionalForm]],
  ExpressionUUID->"c8b2e385-c9ea-4abf-a7ed-3e90e40b893f"],
