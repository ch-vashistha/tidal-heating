 RowBox[{
  RowBox[{"rotation1Rules", "=", 
   RowBox[{"Join", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"lVec", "[", "a", "]"}], ",", 
