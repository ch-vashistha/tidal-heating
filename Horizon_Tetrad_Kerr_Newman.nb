         RowBox[{"AReal", "[", "]"}], "*", 
         RowBox[{"nVec", "[", "a", "]"}]}]}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"mVec", "[", "a", "]"}], ",", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", "*", 
           RowBox[{"\[Theta]Real", "[", "]"}]}], "]"}], 
         RowBox[{"mVec", "[", "a", "]"}]}]}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", 
