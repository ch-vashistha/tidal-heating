Cell[TextData[{
 StyleBox["BLInKS ",
  FontWeight->"Bold"],
 "provides BL coordinates as a function of KS coordinates, i.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{"t", " ", 
     RowBox[{"(", 
      RowBox[{"v", ",", 
       SubscriptBox["r", "KS"], ",", " ", 
       SubscriptBox["\[Theta]", "KS"], " ", ",", "\[Psi]"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"719d0307-89a0-4b15-a22b-cb5801caa392"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["r", "BL"], "=", " ", 
     RowBox[{
      SubscriptBox["r", "BL"], " ", 
      RowBox[{"(", 
       RowBox[{"v", ",", 
        SubscriptBox["r", "KS"], ",", " ", 
        SubscriptBox["\[Theta]", "KS"], " ", ",", "\[Psi]"}], ")"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"2ffe077d-6c65-402f-824f-430ba92baefa"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "BL"], " ", "=", 
    RowBox[{
     SubscriptBox["\[Theta]", "BL"], " ", 
     RowBox[{"(", 
      RowBox[{"v", ",", 
       SubscriptBox["r", "KS"], ",", " ", 
       SubscriptBox["\[Theta]", "KS"], " ", ",", "\[Psi]"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"aa5156f4-e546-4725-ad34-361c0e9bcaad"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "=", 
    RowBox[{"\[Phi]", " ", 
     RowBox[{"(", 
      RowBox[{"v", ",", 
       SubscriptBox["r", "KS"], ",", " ", 
       SubscriptBox["\[Theta]", "KS"], " ", ",", "\[Psi]"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"dd598e92-add4-460f-af23-02ef0a35db0b"],
 "\nSame goes for ",
 StyleBox["KSInBL",
  FontWeight->"Bold"],
 ". "
}], "Text",
