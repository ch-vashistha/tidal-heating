Cell[BoxData[
 RowBox[{
  RowBox[{"directionalDerivativeRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"opD", "[", "x_", "]"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "=", 
          RowBox[{"DummyIn", "[", "TangentM", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"lVec", "[", "a", "]"}], " ", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "a"}], "]"}], "[", "x", "]"}]}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"op\[CapitalDelta]", "[", "x_", "]"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "=", 
          RowBox[{"DummyIn", "[", "TangentM", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"nVec", "[", "a", "]"}], " ", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "a"}], "]"}], "[", "x", "]"}]}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"op\[Delta]", "[", "x_", "]"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "=", 
          RowBox[{"DummyIn", "[", "TangentM", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"mVec", "[", "a", "]"}], " ", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "a"}], "]"}], "[", "x", "]"}]}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"op\[Delta]bar", "[", "x_", "]"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "=", 
          RowBox[{"DummyIn", "[", "TangentM", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"mbarVec", "[", "a", "]"}], " ", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "a"}], "]"}], "[", "x", "]"}]}]}], "]"}]}]}], "}"}]}],
   ";"}]], "Input",
