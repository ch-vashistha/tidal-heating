Notebook[{

Cell[CellGroupData[{
Cell[TextData[StyleBox["Constructing a horizon-regular tetrad for Kerr-Newman \
BHs ",
 FontSize->36]], "Title",
 CellChangeTimes->{{3.969504652447121*^9, 3.969504656487173*^9}, {
  3.9907627048414574`*^9, 3.990762708847396*^9}, {3.9907627453381295`*^9, 
  3.9907627619028006`*^9}, {3.9959461925740833`*^9, 3.9959461936035714`*^9}, {
  3.996311437760934*^9, 3.9963114910300136`*^9}, {3.996311527415557*^9, 
  3.9963115337660275`*^9}, {3.9965570062876096`*^9, 3.996557014569332*^9}, {
  3.99753877725288*^9, 
  3.9975387781832514`*^9}},ExpressionUUID->"096c0bf9-7b8c-48f7-90e3-\
8048f124261d"],

Cell["\<\
References:
[1] Ezra Newman and Roger Penrose. An Approach to gravitational radiation by \
a method of spin coefficients. J. Math. Phys., 3:566\[Dash]578, 1962.
[2] Saul A. Teukolsky. Perturbations of a rotating black hole. 1. Fundamental \
equations for gravitational electromagnetic and neutrino field perturbations. \
Astrophys. J., 185:635\[Dash]647, 1973. 
[3] Subrahmanyan Chandrasekhar. The mathematical theory of black holes. 1985. \
ISBN 978-0-19-850370-5.
\
\>", "Subtitle",
 CellChangeTimes->{{3.970101476773507*^9, 3.97010150611648*^9}, {
   3.973514220783267*^9, 3.973514232167827*^9}, {3.979801503004608*^9, 
   3.97980151139906*^9}, {3.9907627129033537`*^9, 3.990762737467577*^9}, {
   3.9908593161414824`*^9, 3.9908593417711377`*^9}, {3.990859375981657*^9, 
   3.9908593842834873`*^9}, 3.9974260657627883`*^9, {3.9975120484580736`*^9, 
   3.9975120508692865`*^9}, {3.9975120862068777`*^9, 3.9975120895771694`*^9}},
 FontSize->16,ExpressionUUID->"73c7c7af-a4bb-4890-948e-3730ee20ca5e"],

Cell[CellGroupData[{

Cell["(0) Introduction", "Section",
 CellChangeTimes->{{3.997537463079214*^9, 
  3.997537470128582*^9}},ExpressionUUID->"cc078d7d-24af-4f5a-b0d8-\
43017660fdc8"],

Cell["\<\
This notebook constructs a horizon-regular Newman-Penrose tetrad for the \
Kerr-Newman spacetime. The calculation starts from the Kinnersley tetrad in \
Boyer-Lindquist coordinates and uses a sequence of tetrad rotations together \
with a transformation to Kerr-Schild coordinates. The resulting tetrad is \
regular at the future horizon and is used to evaluate the background Weyl \
scalars and spin coefficients.\
\>", "Text",
 CellChangeTimes->{{3.9975374739221916`*^9, 3.9975375108408527`*^9}, 
   3.9975376333844395`*^9, {3.997538770502889*^9, 
   3.9975387722004385`*^9}},ExpressionUUID->"9eda8560-c337-46f6-a050-\
572e0434a93e"]
}, Open  ]],

