Cell[BoxData[
 RowBox[{
  RowBox[{"rotation3Rules", "=", 
   RowBox[{"Join", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"lVec", "[", "a", "]"}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"AReal", "[", "]"}]}], ")"}], 
         RowBox[{"lVec", "[", "a", "]"}]}]}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
