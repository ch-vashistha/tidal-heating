         RowBox[{"mbarVec", "[", "b", "]"}]}]}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Lambda]NP", "[", "]"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"CD", "[", 
            RowBox[{"-", "b"}], "]"}], "[", 
           RowBox[{"nVec", "[", 
            RowBox[{"-", "a"}], "]"}], "]"}]}], " ", 
         RowBox[{"mbarVec", "[", "a", "]"}], " ", 
         RowBox[{"mbarVec", "[", "b", "]"}]}]}], "}"}], "]"}], ",", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Alpha]NP", "[", "]"}], ",", 
        RowBox[{
         RowBox[{"1", "/", "2"}], " ", 
