Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ABL", "=", " ", 
  RowBox[{"CTensor", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "Q"}], " ", 
       RowBox[{
        RowBox[{"r", "[", "]"}], "/", 
        RowBox[{"Sigma", "[", 
         RowBox[{
          RowBox[{"r", "[", "]"}], ",", 
          RowBox[{"\[Theta]", "[", "]"}]}], "]"}]}]}], ",", "0", ",", "0", 
      ",", 
      RowBox[{"Q", " ", "ang", " ", 
       RowBox[{"r", "[", "]"}], " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"\[Theta]", "[", "]"}], "]"}], "^", "2"}], "/", 
        RowBox[{"Sigma", "[", 
         RowBox[{
          RowBox[{"r", "[", "]"}], ",", 
          RowBox[{"\[Theta]", "[", "]"}]}], "]"}]}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"-", "BL"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.997597415523473*^9, 3.997597479944601*^9}, {
   3.9975975171277037`*^9, 3.997597539163691*^9}, 3.9975975699969687`*^9, {
   3.9976005365454063`*^9, 3.9976005378061523`*^9}},
 CellLabel->
  "In[131]:=",ExpressionUUID->"3c2db478-b4c5-4a0f-8ef3-e20f607b1f6d"],

Cell[BoxData[
 RowBox[{"CTensor", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        InterpretationBox[
         StyleBox["Q",
          ShowAutoStyles->False,
          AutoSpacing->False],
         $CellContext`Q,
         Editable->False], " ", 
        InterpretationBox[
         StyleBox[
          SubscriptBox["r", "BL"],
          ShowAutoStyles->False,
          AutoSpacing->False],
         $CellContext`r[],
         Editable->False]}], 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          InterpretationBox[
           StyleBox["a",
            ShowAutoStyles->False,
            AutoSpacing->False],
           $CellContext`ang,
           Editable->False], "2"], " ", 
