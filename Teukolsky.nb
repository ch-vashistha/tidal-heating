Cell["\<\
Take the LHS of Teukolsky\[CloseCurlyQuote]s equation to compare with the \
equation we have obtained. \
\>", "Text",
 CellChangeTimes->{{3.995945402289452*^9, 
  3.9959454312463503`*^9}},ExpressionUUID->"c546cca8-60b1-43d8-99ae-\
2c1879fbda7b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"teukolskyPaper", " ", "=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"r", "^", "2"}], "+", 
           RowBox[{"ang", "^", "2"}]}], ")"}], "^", "2"}], "/", 
        RowBox[{"met\[CapitalDelta]", "[", "r", "]"}]}], "-", 
       RowBox[{
        RowBox[{"ang", "^", "2"}], " ", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], ")"}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", 
        RowBox[{"2", ",", "0", ",", "0", ",", "0"}], "]"}], "[", "\[Psi]Func",
        "]"}], "[", 
      RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], 
    "\[IndentingNewLine]", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"4", " ", "mass", " ", "ang", " ", 
       RowBox[{"r", "/", 
        RowBox[{"met\[CapitalDelta]", "[", "r", "]"}]}]}], ")"}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", 
        RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "]"}], "[", "\[Psi]Func",
        "]"}], "[", 
      RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], 
    "\[IndentingNewLine]", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"ang", "^", "2"}], "/", 
        RowBox[{"met\[CapitalDelta]", "[", "r", "]"}]}], "-", 
       RowBox[{
        RowBox[{"Csc", "[", "\[Theta]", "]"}], "^", "2"}]}], ")"}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", 
        RowBox[{"0", ",", "0", ",", "0", ",", "2"}], "]"}], "[", "\[Psi]Func",
        "]"}], "[", 
      RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[Phi]"}], "]"}]}], 
    "\[IndentingNewLine]", "-", 
    RowBox[{
     RowBox[{
      RowBox[{"met\[CapitalDelta]", "[", "r", "]"}], "^", 
      RowBox[{"(", 
       RowBox[{"-", "spin"}], ")"}]}], " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
