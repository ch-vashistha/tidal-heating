 RowBox[{
  RowBox[{"spinCoeffRules", "=", 
   RowBox[{"Join", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Kappa]NP", "[", "]"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "b"}], "]"}], "[", 
