     "\[IndentingNewLine]", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Lambda]NP", "[", "]"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"CD", "[", 
            RowBox[{"-", "b"}], "]"}], "[", 
           RowBox[{"nVec", "[", 
            RowBox[{"-", "a"}], "]"}], "]"}]}], " ", 
         RowBox[{"mbarVec", "[", "a", "]"}], " ", 
