Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\"\<\\\\left[\\\\frac{(r^2+a^2)^2}{\\\\Delta}-a^2\\\\sin^2\\\\theta\
\\\\right]\\\\frac{\\\\partial^2\\\\psi}{\\\\partial t^2}\n+\\\\frac{4Mar}{\\\
\\Delta}\\\\frac{\\\\partial^2\\\\psi}{\\\\partial t\\\\,\\\\partial\\\\phi}\n\
+\\\\left[\\\\frac{a^2}{\\\\Delta}-\\\\frac{1}{\\\\sin^2\\\\theta}\\\\right]\\\
\\frac{\\\\partial^2\\\\psi}{\\\\partial\\\\phi^2}\n\
-\\\\Delta^{-s}\\\\frac{\\\\partial}{\\\\partial r}\\\\left(\\\\Delta^{s+1}\\\
\\frac{\\\\partial\\\\psi}{\\\\partial r}\\\\right)\n\
-\\\\frac{1}{\\\\sin\\\\theta}\\\\frac{\\\\partial}{\\\\partial\\\\theta}\\\\\
left(\\\\sin\\\\theta\\\\frac{\\\\partial\\\\psi}{\\\\partial\\\\theta}\\\\\
right)\n-2s\\\\left[\\\\frac{a(r-M)}{\\\\Delta}+\\\\frac{i\\\\cos\\\\theta}{\\\
\\sin^2\\\\theta}\\\\right]\\\\frac{\\\\partial\\\\psi}{\\\\partial\\\\phi}\n\
-2s\\\\left[\\\\frac{M(r^2-a^2)}{\\\\Delta}-r-ia\\\\cos\\\\theta\\\\right]\\\\\
frac{\\\\partial\\\\psi}{\\\\partial t}\n\
+\\\\left(s^2\\\\cot^2\\\\theta-s\\\\right)\\\\psi - 4\\\\pi\\\\Sigma T = 0\>\
\"", "//", "MaTeX"}]], "Input",
 CellOpen->False,
 CellChangeTimes->{{3.9913738472503166`*^9, 3.9913739071318274`*^9}, 
