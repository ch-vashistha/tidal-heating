              RowBox[{"-", "a"}], "]"}], "]"}], " ", 
            RowBox[{"nVec", "[", "a", "]"}], " ", 
            RowBox[{"mbarVec", "[", "b", "]"}]}], "-", 
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "b"}], "]"}], "[", 
             RowBox[{"mVec", "[", 
              RowBox[{"-", "a"}], "]"}], "]"}], " ", 
            RowBox[{"mbarVec", "[", "a", "]"}], " ", 
