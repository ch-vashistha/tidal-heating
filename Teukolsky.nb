Cell[BoxData[
 RowBox[{
  RowBox[{"DefTensor", "[", 
   RowBox[{
    RowBox[{"\[CapitalPsi]0pert", "[", "]"}], ",", "M", ",", 
    RowBox[{
    "PrintAs", "\[Rule]", 
     "\"\<\!\(\*SuperscriptBox[SubscriptBox[\(\[CapitalPsi]\), \(0\)], \(B\)]\
\)\>\""}]}], "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.9907681781144466`*^9, 3.990768218150859*^9}, {
  3.990769021180503*^9, 3.9907690239006414`*^9}},
 CellLabel->"In[63]:=",ExpressionUUID->"91028e92-ee2a-47bd-a924-ae5071644b31"],

Cell[TextData[{
 "We consider the vacuum case, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["T", "0"], " ", "=", " ", "0"}], TraditionalForm]],
  ExpressionUUID->"a1a211a5-3371-40eb-b281-bd3395df0ed0"],
 "\n\nWe simplify the LHS of the above equation by distributing out the \
differential operators:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"D", "+", "A"}], ")"}], 
       RowBox[{"(", 
        RowBox[{"\[CapitalDelta]", "+", "B"}], ")"}]}], " ", "-", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Delta]", " ", "+", " ", 
         RowBox[{"A", "'"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[Delta]", "*"], " ", "+", " ", 
         RowBox[{"B", "'"}]}], ")"}]}], " ", "-", 
      RowBox[{"3", 
       SubscriptBox["\[CapitalPsi]", "2"]}]}], "]"}], 
    SuperscriptBox[
     SubscriptBox["\[CapitalPsi]", "0"], "B"]}], TraditionalForm]],
  ExpressionUUID->"05eb7096-c576-4756-a954-46505d9b2358"],
 Cell[BoxData[" "],
  CellChangeTimes->{{3.9907681781144466`*^9, 3.990768218150859*^9}, {
   3.990769021180503*^9, 3.9907690239006414`*^9}},ExpressionUUID->
  "61f0236d-4765-45b4-87b4-42718a59bc7b"],
 "  = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"D", " ", 
     SuperscriptBox[
      SubscriptBox["\[CapitalDelta]\[CapitalPsi]", "0"], "B"]}], "+", 
    RowBox[{"D", " ", 
     RowBox[{"(", 
      SuperscriptBox[
       SubscriptBox["B\[CapitalPsi]", "0"], "B"], ")"}]}], "+", 
    RowBox[{"A", " ", 
     SuperscriptBox[
      SubscriptBox["\[CapitalDelta]\[CapitalPsi]", "0"], "B"]}], "+", 
    RowBox[{"AB", " ", 
     SuperscriptBox[
      SubscriptBox["\[CapitalPsi]", "0"], "B"], " ", 
     FormBox[
      RowBox[{
       RowBox[{
        RowBox[{"-", " ", "\[Delta]"}], " ", 
        SuperscriptBox["\[Delta]", "*"], " ", 
        SuperscriptBox[
         SubscriptBox["\[CapitalPsi]", "0"], "B"]}], "+", 
       RowBox[{"\[Delta]", "(", 
        RowBox[{
         RowBox[{"B", "'"}], 
         SuperscriptBox[
          SubscriptBox["\[CapitalPsi]", "0"], "B"]}], ")"}], "+", 
       RowBox[{
        RowBox[{"A", "'"}], " ", 
        SuperscriptBox["\[Delta]", "*"], " ", 
        SuperscriptBox[
         SubscriptBox["\[CapitalPsi]", "0"], "B"]}], "+", 
       RowBox[{
        RowBox[{"A", "'"}], 
        RowBox[{"B", "'"}], " ", 
        SuperscriptBox[
         SubscriptBox["\[CapitalPsi]", "0"], 
         RowBox[{"B", " "}]]}], "-", 
       RowBox[{"3", 
        SubscriptBox["\[CapitalPsi]", "2"], 
        SuperscriptBox[
         SubscriptBox["\[CapitalPsi]", "0"], "B"], " "}]}],
      TraditionalForm]}]}], TraditionalForm]],ExpressionUUID->
  "af2a2366-2ea8-4667-94ca-12fff704c7f3"],
 "\n\nWhere,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"A", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], "\[Epsilon]"}], "+", 
     SuperscriptBox["\[Epsilon]", "*"], "-", 
     RowBox[{"4", "\[Rho]"}], "-", 
     SuperscriptBox["\[Rho]", "*"]}]}], TraditionalForm]],
  InitializationCell->True,
  FormatType->"TraditionalForm",ExpressionUUID->
  "befb950e-03a1-405c-a6a5-b63c1ad1ccc5"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"B", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "4"}], " ", "\[Gamma]"}], "+", "\[Mu]"}]}], 
   TraditionalForm]],
  InitializationCell->True,
  FormatType->"TraditionalForm",ExpressionUUID->
  "414ac72f-f726-452d-a8e1-9060bc392ac3"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", "'"}], "=", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       InterpretationBox[
        StyleBox["\[Alpha]",
         ShowAutoStyles->False,
         AutoSpacing->False],
        $CellContext`\[Alpha]NP[],
        Editable->False], "*"]}], "+", 
     SuperscriptBox[
      InterpretationBox[
       StyleBox["\[Pi]",
        ShowAutoStyles->False,
        AutoSpacing->False],
       $CellContext`\[Pi]NP[],
       Editable->False], "*"], "-", 
     RowBox[{"3", " ", 
      InterpretationBox[
       StyleBox["\[Beta]",
        ShowAutoStyles->False,
        AutoSpacing->False],
       $CellContext`\[Beta]NP[],
       Editable->False]}], "-", 
     RowBox[{"4", " ", 
      InterpretationBox[
       StyleBox["\[Tau]",
        ShowAutoStyles->False,
        AutoSpacing->False],
       $CellContext`\[Tau]NP[],
       Editable->False]}]}]}], TraditionalForm]],
  InitializationCell->True,
  FormatType->"TraditionalForm",ExpressionUUID->
  "672a1f9e-b345-408c-b70a-ce4ada9db5b3"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"B", "'"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "4"}], " ", 
      InterpretationBox[
       StyleBox["\[Alpha]",
        ShowAutoStyles->False,
        AutoSpacing->False],
       $CellContext`\[Alpha]NP[],
       Editable->False]}], "+", 
     InterpretationBox[
      StyleBox["\[Pi]",
       ShowAutoStyles->False,
       AutoSpacing->False],
      $CellContext`\[Pi]NP[],
      Editable->False]}]}], TraditionalForm]],
  InitializationCell->True,
  FormatType->"TraditionalForm",ExpressionUUID->
  "1ac4dd4d-e173-4217-aad2-3387ac67f673"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.991117502780084*^9, 3.9911176337054763`*^9}, {
   3.9913750951244617`*^9, 3.9913752249143*^9}, {3.991375257464407*^9, 
