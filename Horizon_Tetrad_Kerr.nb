         RowBox[{"1", "/", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "b"}], "]"}], "[", 
             RowBox[{"lVec", "[", 
              RowBox[{"-", "a"}], "]"}], "]"}], " ", 
            RowBox[{"nVec", "[", "a", "]"}], " ", 
            RowBox[{"lVec", "[", "b", "]"}]}], "-", 
           RowBox[{
            RowBox[{
             RowBox[{"CD", "[", 
              RowBox[{"-", "b"}], "]"}], "[", 
             RowBox[{"mVec", "[", 
              RowBox[{"-", "a"}], "]"}], "]"}], " ", 
            RowBox[{"mbarVec", "[", "a", "]"}], " ", 
            RowBox[{"lVec", "[", "b", "]"}]}]}], ")"}]}]}], "}"}], "]"}], ",", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
