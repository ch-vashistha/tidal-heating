Cell["\<\

Define the directional derivatives: \
\>", "Text",
 CellChangeTimes->{{3.9907630660101256`*^9, 3.990763072700152*^9}, 
   3.990764056330202*^9},ExpressionUUID->"576f865b-4094-4d52-b4e2-\
f4dbe096c2aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"directionalDerivativeRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"opD", "[", "x_", "]"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "=", 
          RowBox[{"DummyIn", "[", "TangentM", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"lVec", "[", "a", "]"}], " ", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "a"}], "]"}], "[", "x", "]"}]}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"op\[CapitalDelta]", "[", "x_", "]"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "=", 
          RowBox[{"DummyIn", "[", "TangentM", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"nVec", "[", "a", "]"}], " ", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "a"}], "]"}], "[", "x", "]"}]}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"op\[Delta]", "[", "x_", "]"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "=", 
          RowBox[{"DummyIn", "[", "TangentM", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"mVec", "[", "a", "]"}], " ", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "a"}], "]"}], "[", "x", "]"}]}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"op\[Delta]bar", "[", "x_", "]"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "=", 
          RowBox[{"DummyIn", "[", "TangentM", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"mbarVec", "[", "a", "]"}], " ", 
         RowBox[{
          RowBox[{"CD", "[", 
           RowBox[{"-", "a"}], "]"}], "[", "x", "]"}]}]}], "]"}]}]}], "}"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.990767412909412*^9, 3.990767456788955*^9}, 
   3.9907687984706254`*^9, 3.9907689118506017`*^9, {3.9911173817554092`*^9, 
   3.9911174008223667`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"5b6ca358-880b-461e-a964-85b3b43070c4"],

