Cell[CellGroupData[{

Cell[TextData[StyleBox["STAGE 2: \nBoyer-Lindquist coordinates + class-III \
rotated Kinnersley tetrad",
 FontSize->22]], "Subsection",
 CellChangeTimes->{{3.996119382550145*^9, 3.996119412220377*^9}, {
   3.9961199988096294`*^9, 3.9961200086794276`*^9}, 
   3.996120052082369*^9},ExpressionUUID->"de01d878-fbd7-4cfc-8e4d-\
e0ce327e1c76"],

Cell[TextData[{
 "Under a tetrad transformation, the coordinate basis components of the \
metric do not change, hence neither do the components of the curvature \
tensors thus constructed. However, the NP scalars (Ricci, Weyl, spin \
coefficients) will transform under the rotation. \n\nHence there is no need \
to re-evaluate the curvature tensors. \nThe choice of class-III rotation \
parameters is, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", " ", "=", " ", 
     FractionBox[
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          InterpretationBox[
           StyleBox["a",
            ShowAutoStyles->False,
            AutoSpacing->False],
           $CellContext`ang,
           Editable->False], "2"], "+", 
         SuperscriptBox[
          InterpretationBox[
           StyleBox[
            SubscriptBox["r", "BL"],
            ShowAutoStyles->False,
            AutoSpacing->False],
           $CellContext`r[],
           Editable->False], "2"]}], ")"}]}], 
      RowBox[{
       SuperscriptBox[
        InterpretationBox[
         StyleBox["a",
          ShowAutoStyles->False,
          AutoSpacing->False],
         $CellContext`ang,
         Editable->False], "2"], "-", 
       RowBox[{"2", " ", 
        InterpretationBox[
         StyleBox["M",
          ShowAutoStyles->False,
          AutoSpacing->False],
         $CellContext`mass,
         Editable->False], " ", 
        InterpretationBox[
         StyleBox[
          SubscriptBox["r", "BL"],
          ShowAutoStyles->False,
          AutoSpacing->False],
         $CellContext`r[],
         Editable->False]}], "+", 
       SuperscriptBox[
        InterpretationBox[
         StyleBox[
          SubscriptBox["r", "BL"],
          ShowAutoStyles->False,
          AutoSpacing->False],
         $CellContext`r[],
         Editable->False], "2"]}]]}], ",", " ", 
    RowBox[{"\[Theta]", "=", "0"}]}], TraditionalForm]],ExpressionUUID->
  "c7866186-3e45-4175-9df5-45e2cf29f36f"],
 ". \n\nSo first rotate the tetrad in abstract form, then apply the rotation \
parameters. Finally evaluate the NP scalars. "
}], "Text",
 CellChangeTimes->{{3.9961249559013925`*^9, 3.99612514862122*^9}, {
  3.996125181124439*^9, 3.996125327657158*^9}, {3.9975114844525633`*^9, 
  3.997511506571892*^9}, {3.9975384730535374`*^9, 
  3.9975384754372025`*^9}},ExpressionUUID->"4b97356e-1baa-4df8-a811-\
f8f04741fa15"],

