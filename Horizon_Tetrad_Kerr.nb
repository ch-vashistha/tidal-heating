     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Pi]NP", "[", "]"}], ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"CD", "[", 
            RowBox[{"-", "b"}], "]"}], "[", 
           RowBox[{"nVec", "[", 
            RowBox[{"-", "a"}], "]"}], "]"}]}], " ", 
         RowBox[{"mbarVec", "[", "a", "]"}], " ", 
         RowBox[{"lVec", "[", "b", "]"}]}]}], "}"}], "]"}], ",", 
     RowBox[{"MakeRule", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Epsilon]NP", "[", "]"}], ",", 
