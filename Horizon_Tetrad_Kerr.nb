Cell[CellGroupData[{

Cell["Defining rules for the abstract tensors", "Subsubsection",
 CellChangeTimes->{{3.9643303124408035`*^9, 3.964330319250821*^9}, {
  3.990838845869072*^9, 3.990838851452861*^9}, {3.9959564171592054`*^9, 
  3.995956424740201*^9}},ExpressionUUID->"645492f6-40eb-491c-a512-\
ba85df8428cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"componentRulesBL", "=", " ", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{
        RowBox[{"-", "a_Symbol"}], ",", " ", 
        RowBox[{"-", "b_Symbol"}]}], "]"}], " ", ":>", " ", 
      RowBox[{"gBL", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", " ", 
        RowBox[{"-", "b"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Z", "[", 
       RowBox[{
        RowBox[{"-", "a_Symbol"}], ",", " ", 
        RowBox[{"-", "b_Symbol"}]}], "]"}], " ", ":>", " ", 
      RowBox[{"ZeroMatrixBL", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", " ", 
        RowBox[{"-", "b"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"V", "[", 
       RowBox[{"-", "a_Symbol"}], "]"}], "\[RuleDelayed]", 
      RowBox[{"ZeroVectorBL", "[", 
       RowBox[{"-", "a"}], "]"}]}], ",", "\[IndentingNewLine]", " ", 
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"a_Symbol", ",", " ", "b_Symbol"}], "]"}], " ", ":>", " ", 
      RowBox[{"invgBL", "[", 
       RowBox[{"a", ",", " ", "b"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CD", "[", 
       RowBox[{"-", "a_Symbol"}], "]"}], " ", ":>", " ", 
      RowBox[{"CDBL", "[", 
       RowBox[{"-", "a"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"PD", "[", 
       RowBox[{"-", "a_Symbol"}], "]"}], " ", ":>", " ", 
      RowBox[{"PDBL", "[", 
       RowBox[{"-", "a"}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RicciCD", "[", 
       RowBox[{
        RowBox[{"-", "a_Symbol"}], ",", " ", 
        RowBox[{"-", "b_Symbol"}]}], "]"}], " ", ":>", " ", 
      RowBox[{"RicciCDBL", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", " ", 
        RowBox[{"-", "b"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"WeylCD", "[", 
       RowBox[{
        RowBox[{"-", "a_Symbol"}], ",", " ", 
        RowBox[{"-", "b_Symbol"}], ",", 
        RowBox[{"-", "c_Symbol"}], ",", " ", 
        RowBox[{"-", "d_Symbol"}]}], "]"}], " ", ":>", " ", 
      RowBox[{"WeylCDBL", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", " ", 
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "c"}], ",", 
        RowBox[{"-", "d"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"RicciScalarCD", "[", "]"}], " ", ":>", " ", 
      RowBox[{"ScalarCDBL", "[", "]"}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"tetrad", " ", "vectors"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lVec", "[", "a_Symbol", "]"}], " ", ":>", " ", 
      RowBox[{"lBL", "[", "a", "]"}]}], ",", "\[IndentingNewLine]", 
