           RowBox[{"\[Theta]Real", "[", "]"}]}], "]"}], 
         RowBox[{"mbarVec", "[", "a", "]"}]}]}], "}"}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
