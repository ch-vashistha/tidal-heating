  RowBox[{"CTensor", "[", 
   RowBox[{
    RowBox[{"2", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"r", "[", "]"}], "^", "2"}], "+", 
        RowBox[{"ang", "^", "2"}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"met\[CapitalDelta]", "[", 
        RowBox[{"r", "[", "]"}], "]"}], ")"}]}]}], ",", 
    RowBox[{"{", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9962217546491065`*^9, 3.9962217606391954`*^9}, 
