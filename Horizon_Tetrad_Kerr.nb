        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"AReal", "[", "]"}]}], ")"}], 
         RowBox[{"lVec", "[", "a", "]"}]}]}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", 
