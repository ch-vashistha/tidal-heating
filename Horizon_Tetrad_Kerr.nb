        RowBox[{"nVec", "[", "a", "]"}], ",", 
        RowBox[{
         RowBox[{"nVec", "[", "a", "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"aComp", "[", "]"}], "*", 
            RowBox[{"Conjugate", "[", 
             RowBox[{"aComp", "[", "]"}], "]"}]}], ")"}], 
          RowBox[{"lVec", "[", "a", "]"}]}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
