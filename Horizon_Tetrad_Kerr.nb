Cell[TextData[{
 "The class-III rotation has a scaling effect on the Weyl scalars except ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalPsi]", "2"], " "}], TraditionalForm]],
  ExpressionUUID->"698cd7f1-6e56-4544-aed7-19746f617112"],
 ". But they were zero to begin with, hence remain the same. "
