Cell[TextData[{
 StyleBox["BLInKS ",
  FontWeight->"Bold"],
 "provides BL coordinates as a function of KS coordinates, i.e.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    RowBox[{"t", " ", 
     RowBox[{"(", 
      RowBox[{"v", ",", 
       SubscriptBox["r", "KS"], ",", " ", 
       SubscriptBox["\[Theta]", "KS"], " ", ",", "\[Psi]"}], ")"}]}]}], 
   TraditionalForm]],
  FormatType->"TraditionalForm",ExpressionUUID->
  "f57392bd-2387-4155-a8d2-d00cab9d2b0f"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["r", "BL"], "=", " ", 
     RowBox[{
      SubscriptBox["r", "BL"], " ", 
      RowBox[{"(", 
       RowBox[{"v", ",", 
        SubscriptBox["r", "KS"], ",", " ", 
        SubscriptBox["\[Theta]", "KS"], " ", ",", "\[Psi]"}], ")"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"d8e6a0e5-9b39-4a74-ab4d-e838c125f6af"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Theta]", "BL"], " ", "=", 
    RowBox[{
     SubscriptBox["\[Theta]", "BL"], " ", 
     RowBox[{"(", 
      RowBox[{"v", ",", 
       SubscriptBox["r", "KS"], ",", " ", 
       SubscriptBox["\[Theta]", "KS"], " ", ",", "\[Psi]"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"9a5897c2-e27e-49dc-a3f4-d4c9ec4725ea"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "=", 
    RowBox[{"\[Phi]", " ", 
     RowBox[{"(", 
      RowBox[{"v", ",", 
       SubscriptBox["r", "KS"], ",", " ", 
       SubscriptBox["\[Theta]", "KS"], " ", ",", "\[Psi]"}], ")"}]}]}], 
   TraditionalForm]],ExpressionUUID->"c7116321-15d7-4f46-bc26-21d8c07be580"],
 "\nSame goes for ",
 StyleBox["KSInBL",
  FontWeight->"Bold"],
 ". "
}], "Text",
 CellChangeTimes->{{3.9972524355729337`*^9, 3.997252511084141*^9}, {
  3.997322927472172*^9, 3.997322985831052*^9}, {3.9973341710614853`*^9, 
  3.9973342901932135`*^9}},ExpressionUUID->"f08a9b18-cac1-4d46-ac7c-\
588d557da02a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"KSInBL", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"t", "[", "]"}], "+", 
      RowBox[{"rStar", "[", 
       RowBox[{"r", "[", "]"}], "]"}]}], ",", 
     RowBox[{"r", "[", "]"}], ",", 
     RowBox[{"\[Theta]", "[", "]"}], ",", 
     RowBox[{
      RowBox[{"\[Phi]", "[", "]"}], "+", 
      RowBox[{"rBar", "[", 
       RowBox[{"r", "[", "]"}], "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"BLInKS", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"v", "[", "]"}], "-", 
      RowBox[{"rStar", "[", 
       RowBox[{"rKS", "[", "]"}], "]"}]}], ",", 
     RowBox[{"rKS", "[", "]"}], ",", 
     RowBox[{"\[Theta]KS", "[", "]"}], ",", 
     RowBox[{
      RowBox[{"\[Psi]", "[", "]"}], "-", 
      RowBox[{"rBar", "[", 
       RowBox[{"rKS", "[", "]"}], "]"}]}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.996305381618165*^9, 3.9963053861031485`*^9}, {
