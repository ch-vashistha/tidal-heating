Cell[BoxData[
 RowBox[{"gBL", "=", 
  RowBox[{"CTensor", "[", 
   RowBox[{
    RowBox[{"{", "\n", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", "*", "mass", "*", 
           RowBox[{
            RowBox[{"r", "[", "]"}], "/", 
            RowBox[{"Sigma", "[", 
             RowBox[{
              RowBox[{"r", "[", "]"}], ",", 
              RowBox[{"\[Theta]", "[", "]"}]}], "]"}]}]}]}], ")"}], ",", "0", 
        ",", "0", ",", 
        RowBox[{"2", "mass", " ", "ang", " ", 
         RowBox[{"r", "[", "]"}], 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]", "[", "]"}], "]"}], "^", "2"}], "/", 
          RowBox[{"Sigma", "[", 
           RowBox[{
            RowBox[{"r", "[", "]"}], ",", 
            RowBox[{"\[Theta]", "[", "]"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Sigma", "[", 
           RowBox[{
            RowBox[{"r", "[", "]"}], ",", 
            RowBox[{"\[Theta]", "[", "]"}]}], "]"}]}], "/", 
         RowBox[{"Delta", "[", 
          RowBox[{"r", "[", "]"}], "]"}]}], ",", "0", ",", "0"}], "}"}], ",", 
      "\n", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", 
        RowBox[{"-", 
         RowBox[{"Sigma", "[", 
          RowBox[{
           RowBox[{"r", "[", "]"}], ",", 
           RowBox[{"\[Theta]", "[", "]"}]}], "]"}]}], ",", "0"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "mass", " ", "ang", " ", 
         RowBox[{"r", "[", "]"}], 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"\[Theta]", "[", "]"}], "]"}], "^", "2"}], "/", 
          RowBox[{"Sigma", "[", 
           RowBox[{
            RowBox[{"r", "[", "]"}], ",", 
            RowBox[{"\[Theta]", "[", "]"}]}], "]"}]}]}], ",", "0", ",", "0", 
        ",", 
        RowBox[{
